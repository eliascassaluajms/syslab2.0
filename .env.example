# Copia este archivo como .env y reemplaza los valores según tu entorno.

# Configuración del servidor
PORT=5000
NODE_ENV=development

# Credenciales de PostgreSQL (deben coincidir con DATABASE_URL)
POSTGRES_USER=admin_syslab
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=syslab_db
POSTGRES_HOST=postgres-db

# Autenticación JWT (obligatoria. Usa una clave larga y aleatoria)
JWT_SECRET=cambia_esta_clave_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Orígenes permitidos
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Conexión a la base de datos (host postgres-db cuando se usa Docker)
DATABASE_URL=postgresql://admin_syslab:cambia_esta_clave@postgres-db:5432/syslab_db?schema=public

# URL base de la API consumida por el frontend
VITE_API_URL=/api